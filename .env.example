# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:../data/app.db"

# Min 32 characters — used to sign admin session cookies
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Used by the seed script to create/update the first admin account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"

# Public site URL (no trailing slash) — used for SEO canonical/hreflang/sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
